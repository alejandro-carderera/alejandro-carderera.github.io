<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign visible_news_limit = news_limit %}
    {% assign archived_news_limit = 0 %}
    {% if include.limit and page.announcements.scrollable and news_limit > 3 %}
      {% assign visible_news_limit = 3 %}
      {% assign archived_news_limit = news_limit | minus: visible_news_limit %}
    {% endif %}

    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: visible_news_limit %}
          {% include news_item.liquid item=item %}
        {% endfor %}
      </table>
    </div>

    {% if archived_news_limit > 0 %}
      <details class="news-archive">
        <summary>
          <span class="when-closed">Show {{ archived_news_limit }} older updates</span>
          <span class="when-open">Hide older updates</span>
        </summary>
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in news offset: visible_news_limit limit: archived_news_limit %}
              {% include news_item.liquid item=item %}
            {% endfor %}
          </table>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
