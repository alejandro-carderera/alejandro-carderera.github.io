---
layout: default
---
<div class="post">
  <header class="post-header about-hero">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="about-hero__given-name font-weight-bold">{{ site.first_name }}</span>
        {% if site.middle_name != blank %}
          <span class="about-hero__middle-name">{{ site.middle_name }}</span>
        {% endif %}
        <span class="about-hero__family-name">{{ site.last_name }}</span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class
            sizes="(max-width: 575px) 132px, (max-width: 929px) calc(30vw - 9px), 270px" alt="Alejandro Carderera"
            width=1140 height=1140 cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {% if page.social %}
          <div class="social profile-social">
            <div class="contact-icons">{% social_links %}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}
    <div class="about-intro">{{ content }}</div>
  </header>

  <article>
    <hr class="section-divider">

    {% if page.featured_work and page.featured_work.enabled %}
      <section class="featured-work" aria-labelledby="featured-work-title">
        <div class="featured-work__content">
          <h2 id="featured-work-title" class="featured-work__title">
            <a href="{{ page.featured_work.url }}">{{ page.featured_work.title }}</a>
          </h2>
          <p class="featured-work__subtitle">{{ page.featured_work.subtitle }}</p>
          <p class="featured-work__summary">{{ page.featured_work.description }}</p>
          <div class="featured-work__links">
            <a href="{{ page.featured_work.url }}">
              Explore the benchmark
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            </a>
            <a href="{{ page.featured_work.announcement_url }}">
              Read the launch post
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
            </a>
          </div>
        </div>
        <ul class="featured-work__facts" aria-label="ReviewBench benchmark facts">
          {% for fact in page.featured_work.facts %}
            <li>
              <strong>{{ fact.value }}</strong>
              <span>{{ fact.label }}</span>
            </li>
          {% endfor %}
        </ul>
      </section>

      <hr class="section-divider">
    {% endif %}

    <!-- Professional Experience -->
    <h2 class="mt-3">Professional Experience</h2>
    {% include experience.liquid limit=4 %}

    <hr class="section-divider">

    <!-- Education -->
    <h2 class="mt-3">Education</h2>
    {% include education.liquid %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <hr class="section-divider">

      <h2 class="mt-3">News</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <hr class="section-divider">

      <h2 class="mt-3">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <hr class="section-divider">

      <h2 class="mt-3">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      <div class="selected-publications">
        {% include selected_papers.liquid %}
        <a class="selected-publications-all" href="{{ '/publications/' | relative_url }}">View all publications</a>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
